# מפתח OpenRouter (חובה לשרת הצ'אט) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# מודל ראשי (ברירת מחדל: Qwen 2.5 72B — עברית חזקה ועלות סבירה)
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# מודל גיבוי בעת תקלה / עומס
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# אופציות נוספות:
# OPENROUTER_MODEL=deepseek/deepseek-chat
# OPENROUTER_MODEL=deepseek/deepseek-r1
# OPENROUTER_MODEL=minimax/minimax-01

# מפתח ישן (לא בשימוש בצ'אטבוט)
GEMINI_API_KEY=
