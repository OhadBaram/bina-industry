# מפתח OpenRouter (חובה לשרת הצ'אט ולניתוח לידים) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# מודל ראשי לצ'אט (ברירת מחדל: Qwen 2.5 72B — עברית חזקה ועלות סבירה)
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# מודל גיבוי בעת תקלה / עומס
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# מודל לניתוח פניות מהטופס (אופציונלי; ברירת מחדל: deepseek/deepseek-chat)
OPENROUTER_LEAD_MODEL=
OPENROUTER_LEAD_FALLBACK_MODEL=

# --- קליטת לידים (/api/lead) — כל הערוצים אופציונליים; בלי מפתח הערוץ פשוט מדולג ---

# טלגרם — בוט + מזהה צ'אט לקבלת התראה מיידית
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# מייל דרך Resend — https://resend.com
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# כתובת השולח (דומיין מאומת ב-Resend). לבדיקה: בינה לתעשייה <onboarding@resend.dev>
LEAD_EMAIL_FROM=

# גיליון Google — דרך פשוטה: כתובת Web App של Apps Script
GOOGLE_SHEETS_WEBHOOK_URL=

# גיליון Google — דרך מתקדמת (חשבון שירות), רק אם אין webhook:
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# לחלופין JSON מלא בשורה אחת (לא מומלץ ב-UI אם אפשר לפצל):
GOOGLE_SERVICE_ACCOUNT_JSON=

# מפתח ישן (לא בשימוש בצ'אטבוט)
GEMINI_API_KEY=
